{{- if eq (env "USE_EXTERNAL_SECRETS") "true" }}
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: oci-vault-store
spec:
  provider:
    oracle:
      vault: "ocid1.vault.oc1..."
      region: "eu-frankfurt-1"
      auth:
        user: "ocid1.user.oc1..."
        tenancy: "ocid1.tenancy.oc1..."
        secretRef:
          privatekey:
            name: oci-credentials
            key: privateKey
          fingerprint:
            name: oci-credentials
            key: fingerprint
{{- end }}
