# =============================================================================
# Example environment file — DO NOT put real secrets here.
# Copy to environments/default.env (git-ignored) and fill in the values.
# =============================================================================

export CLUSTER_FQDN="do.sysops.ro"

# A name for the dex identity, to identify it. Use the subdomain pointing to
# the cluster itself.
export DEX_NAME="SYSOPS-K8S-DO"
# Random secret shared by dex and dex-k8s-authenticator. ie pwgen -snc 32 1
export DEX_SECRET=""

# Google Workspace domains allowed to log in (space separated).
export GOOG_ALLOWED_DOMAIN="sysops.ro"
export GOOG_CLIENT_ID=""
export GOOG_CLIENT_SECRET=""

# Required when the cert-manager ClusterIssuer is enabled; used for both
# Let's Encrypt and ZeroSSL.
export ACME_EMAIL=""
# ZeroSSL EAB credentials (required when CERT_PROVIDER=zerossl; also used by the
# dedicated zerossl-issuer chart).
export ZEROSSL_EAB=""
export ZEROSSL_EMAIL="alecs@sysops.ro"
export ZEROSSL_KID=""

# Name prefix for the generated roles/bindings; admins separated by space.
export RBAC_NAME="do-sysops"
export RBAC_ADMIN_USERS="alecs@sysops.ro"
# Default cluster role for any authenticated (non-admin) user, e.g. view.
# Leave empty to disable.
export RBAC_DEFAULT_CLUSTERROLE=""

# -----------------------------------------------------------------------------
# Certificates / DNS / ingress
# -----------------------------------------------------------------------------
# zerossl | letsencrypt
export CERT_PROVIDER="zerossl"
# Set to true ONLY if this repo should install/upgrade cert-manager. When false
# (or when cert-manager is already in the cluster) nothing touches it.
export CERT_MANAGER_ENABLED="true"
# Reuse an existing wildcard TLS secret instead of asking cert-manager to issue
# per-ingress certificates. Empty = per-ingress issuance.
export EXISTING_WILDCARD_CERT_SECRET=""
export DNS_PROVIDER="aws"
export DNS_ENDPOINT=""
export DNS_SECRET_NAME="dns-credentials"

# ClusterIssuer with a DNS-01 solver (uses the cert-manager that already exists
# or the one installed above). auto = create it when cert-manager CRDs exist.
export CERT_MANAGER_ISSUER_ENABLED="auto"
export CERT_MANAGER_ISSUER_NAME="prod-issuer"
# Restrict the solver to these zones (space separated). Empty = all zones.
export DNS_ZONES=""

# -----------------------------------------------------------------------------
# Ingress: public (ingress-nginx) + private (nginx-internal)
# -----------------------------------------------------------------------------
# aws | oci | hetzner | digitalocean | contabo | metal
# Empty = deploy the Service with the cloud default type and no annotations.
# export LB_PROVIDER=""
export INGRESS_CLASS="nginx"
export INGRESS_INTERNAL_CLASS="nginx-internal"

export INSTALL_INGRESS_NGINX="true"
# Defaults to INSTALL_INGRESS_NGINX when unset.
export INSTALL_INGRESS_NGINX_INTERNAL="true"

# Public controller: DaemonSet by default. Setting INGRESS_REPLICAS forces a
# Deployment with that replica count.
export INGRESS_CONTROLLER_KIND="DaemonSet"
# export INGRESS_REPLICAS="3"
# Private controller is always a Deployment.
export INTERNAL_INGRESS_REPLICAS="2"

# auto = enable only when the Prometheus operator CRDs exist.
export INGRESS_METRICS_SERVICEMONITOR="auto"
export INGRESS_WEBHOOK_FAILURE_POLICY="Fail"

# Pin the Ingress status address (IP or FQDN). On OCI the NLB reports both a
# public and an internal IP; an FQDN yields a CNAME via external-dns. Setting it
# disables publishService.
# export PUBLIC_LB_PUBLISH_STATUS_ADDRESS=""
# export INTERNAL_LB_PUBLISH_STATUS_ADDRESS=""

# Real client IP: the default is the concatenation of the Cloudflare and
# CloudFront IPv4+IPv6 ranges (see apps/ingress-nginx/values.yaml.gotmpl).
# Override the whole list with PROXY_REAL_IP_CIDR (comma separated).
# export PROXY_REAL_IP_CIDR=""

# Per-provider load balancer settings (only the used ones matter).
# OCI
export PUBLIC_LB_SUBNET_OCID=""
export PUBLIC_LB_NSG_OCIDS=""
export PUBLIC_LB_RESERVED_IP=""
export INTERNAL_LB_SUBNET_OCID=""
export INTERNAL_LB_SHAPE_MIN="10"
export INTERNAL_LB_SHAPE_MAX="100"
# AWS
export AWS_LB_TAGS=""
export AWS_REGION=""
# Hetzner
export HETZNER_LB_TYPE="lb11"
export HETZNER_LB_LOCATION=""
export HETZNER_LB_NAME=""
# hetzner internal: NodePort by default; set true to request an hcloud LB
export HETZNER_INTERNAL_LB="false"
export HETZNER_INTERNAL_LB_NAME=""
# DigitalOcean
export DO_LB_SIZE="lb-small"
export DO_LB_NAME=""

# -----------------------------------------------------------------------------
# Star (wildcard) certificates + Reflector
# -----------------------------------------------------------------------------
# One wildcard Certificate per domain (main + extras), signed by the DNS-01
# ClusterIssuer and mirrored into all namespaces by Reflector.
# auto = enabled when STAR_MAIN_DOMAIN is set.
export INSTALL_STAR_CERT="auto"
# export STAR_MAIN_DOMAIN="example.com"
# export STAR_EXTRA_DOMAINS="foo.io bar.net"
# Empty = every namespace; space separated list = only those namespaces.
# export STAR_CERT_NAMESPACES=""
# auto = enabled when the star certificate is enabled.
export INSTALL_REFLECTOR="auto"

# -----------------------------------------------------------------------------
# External Secrets Operator ClusterSecretStore (operator/CRDs installed outside)
# -----------------------------------------------------------------------------
export ENABLE_EXTERNAL_SECRETS="false"
# oci | aws
# export EXTERNAL_SECRETS_PROVIDER="oci"
# export EXTERNAL_SECRETS_STORE_NAME=""
# Secret that holds the provider credentials.
# export EXTERNAL_SECRETS_AUTH_SECRET_NAME="oci-credentials"
# OCI Vault
export OCI_VAULT_OCID=""
export OCI_VAULT_REGION=""
export OCI_VAULT_USER_OCID=""
export OCI_VAULT_TENANCY_OCID=""
# AWS Secrets Manager
# export AWS_SECRETS_REGION=""
# secretRef | jwt
# export EXTERNAL_SECRETS_AWS_AUTH="secretRef"
# export EXTERNAL_SECRETS_AWS_SERVICE_ACCOUNT="external-secrets"
# export EXTERNAL_SECRETS_AWS_SERVICE_ACCOUNT_NAMESPACE="external-secrets"

# OCI DNS-01 webhook (only for DNS_PROVIDER=oci; webhook installed outside).
export OCI_DNS_COMPARTMENT_OCID=""
export OCI_DNS_WEBHOOK_GROUP="acme.sysops.ro"
export OCI_DNS_WEBHOOK_SOLVER="oci"
export OCI_DNS_PROFILE_SECRET_NAME=""

# dex-k8s-authenticator image (fully qualified repository).
export DEX_REPO="docker.io/mintel/dex-k8s-authenticator"
export DEX_TAG="latest"
export NODE_ARCH="amd64"
export DEX_ALWAYS_SHOW_LOGIN="false"
export DEX_LOGO_URL=""

# CA bundles used to verify the dex TLS chain.
export ZEROSSL_CA_PEM_FILE="certs/zerossl-ca.pem"
export LETS_ENCRYPT_CA_PEM_FILE="certs/letsencrypt-ca.pem"

# -----------------------------------------------------------------------------
# Serving certificate of kube-oidc-proxy (ingress-nginx -> pod hop).
#   auto (default)  -> reuse the existing secret; if none, use cert-manager when
#                      its CRDs exist, otherwise let the chart generate one
#   adopt           -> always reuse the existing secret (never rotates)
#   cert-manager    -> issue/renew it with cert-manager (works with a
#                      pre-existing cert-manager OR one installed by this repo)
#   chart           -> upstream behaviour: random self-signed cert each render
# -----------------------------------------------------------------------------
export KUBE_OIDC_PROXY_TLS_PROVIDER="auto"
