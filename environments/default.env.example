# =============================================================================
# Example environment file — DO NOT put real secrets here.
# Copy to environments/default.env (git-ignored) and fill in the values.
# =============================================================================

export CLUSTER_FQDN="do.sysops.ro"

# A name for the dex identity, to identify it. Use the subdomain pointing to
# the cluster itself.
export DEX_NAME="SYSOPS-K8S-DO"
# Random secret shared by dex and dex-k8s-authenticator. ie pwgen -snc 32 1
export DEX_SECRET=""

# Google Workspace domains allowed to log in (space separated).
export GOOG_ALLOWED_DOMAIN="sysops.ro"
export GOOG_CLIENT_ID=""
export GOOG_CLIENT_SECRET=""

# ZeroSSL EAB credentials (only needed when CERT_PROVIDER=zerossl).
export ZEROSSL_EAB=""
export ZEROSSL_EMAIL="alecs@sysops.ro"
export ZEROSSL_KID=""

# Name prefix for the generated roles/bindings; admins separated by space.
export RBAC_NAME="do-sysops"
export RBAC_ADMIN_USERS="alecs@sysops.ro"
# Default cluster role for any authenticated (non-admin) user, e.g. view.
# Leave empty to disable.
export RBAC_DEFAULT_CLUSTERROLE=""

# -----------------------------------------------------------------------------
# Certificates / DNS / ingress
# -----------------------------------------------------------------------------
# zerossl | letsencrypt
export CERT_PROVIDER="zerossl"
# Set to true ONLY if this repo should install/upgrade cert-manager. When false
# (or when cert-manager is already in the cluster) nothing touches it.
export CERT_MANAGER_ENABLED="true"
# Reuse an existing wildcard TLS secret instead of asking cert-manager to issue
# per-ingress certificates. Empty = per-ingress issuance.
export EXISTING_WILDCARD_CERT_SECRET=""
export DNS_PROVIDER="aws"
export DNS_ENDPOINT=""
export DNS_SECRET_NAME="dns-credentials"
export USE_EXTERNAL_SECRETS="true"

# Set to true ONLY if this repo should install/upgrade ingress-nginx.
export INSTALL_INGRESS_NGINX="true"
export INGRESS_CLASS="nginx"
# Internal load balancer (OCI) — leave false on DigitalOcean.
export OCI_INTERNAL_LB="false"

# dex-k8s-authenticator image (fully qualified repository).
export DEX_REPO="docker.io/mintel/dex-k8s-authenticator"
export DEX_TAG="latest"
export NODE_ARCH="amd64"
export DEX_ALWAYS_SHOW_LOGIN="false"
export DEX_LOGO_URL=""

# CA bundles used to verify the dex TLS chain.
export ZEROSSL_CA_PEM_FILE="certs/zerossl-ca.pem"
export LETS_ENCRYPT_CA_PEM_FILE="certs/letsencrypt-ca.pem"

# -----------------------------------------------------------------------------
# Serving certificate of kube-oidc-proxy (ingress-nginx -> pod hop).
#   auto (default)  -> reuse the existing secret; if none, use cert-manager when
#                      its CRDs exist, otherwise let the chart generate one
#   adopt           -> always reuse the existing secret (never rotates)
#   cert-manager    -> issue/renew it with cert-manager (works with a
#                      pre-existing cert-manager OR one installed by this repo)
#   chart           -> upstream behaviour: random self-signed cert each render
# -----------------------------------------------------------------------------
export KUBE_OIDC_PROXY_TLS_PROVIDER="auto"
