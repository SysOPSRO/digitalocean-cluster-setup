image:
  repository: {{ env "DEX_REPO" }}
  tag: {{ env "DEX_TAG" }}
  pullPolicy: IfNotPresent
config:
  clusters:
    - name: {{ requiredEnv "DEX_NAME" }}
      short_description: {{ requiredEnv "DEX_NAME" }}
      description: {{ requiredEnv "DEX_NAME" }}
      issuer: https://dex.{{ requiredEnv "CLUSTER_FQDN" }}
      client_id: dex-k8s-auth
      client_secret: {{ requiredEnv "DEX_SECRET" }}
      redirect_uri: https://login.{{ requiredEnv "CLUSTER_FQDN" }}/callback
      k8s_master_uri: https://oidcproxy.{{ requiredEnv "CLUSTER_FQDN" }}
      k8s_ca_pem: |
{{- if eq (env "CERT_PROVIDER") "zerossl" }}
{{ readFile (printf "../../%s" (env "ZEROSSL_CA_PEM_FILE")) | nindent 8 }}
{{- else }}
{{ readFile (printf "../../%s" (env "LETS_ENCRYPT_CA_PEM_FILE")) | nindent 8 }}
{{- end }}

ingress:
  enabled: true
  annotations:
    kubernetes.io/tls-acme: "true"
{{- if env "EXISTING_WILDCARD_CERT_SECRET" }}
    # using existing wildcard cert; no cert-manager issuer
{{- else }}
    cert-manager.io/cluster-issuer: {{ env "CERT_PROVIDER" }}-prod
{{- end }}
    kubernetes.io/ingress.class: {{ default "nginx" (env "INGRESS_CLASS") }}
    external-dns.alpha.kubernetes.io/hostname: login.{{ requiredEnv "CLUSTER_FQDN" }}
  hosts:
    - host: login.{{ requiredEnv "CLUSTER_FQDN" }}
      paths:
        - path: /
          pathType: ImplementationSpecific
  tls:
    - secretName: {{ if env "EXISTING_WILDCARD_CERT_SECRET" }}{{ env "EXISTING_WILDCARD_CERT_SECRET" }}{{ else }}dex-k8s-authenticator-tls{{ end }}
      hosts:
        - login.{{ requiredEnv "CLUSTER_FQDN" }}
{{- if env "NODE_ARCH" }}
nodeSelector:
  kubernetes.io/arch: {{ env "NODE_ARCH" }}
{{- end }}
