{{- /*
Public (internet-facing) ingress-nginx.

Driven by:
  LB_PROVIDER=aws|oci|hetzner|digitalocean|contabo|metal  (optional: no value =
      deploy with the cloud default, without provider annotations)
  INGRESS_CLASS=nginx
  INGRESS_CONTROLLER_KIND=DaemonSet|Deployment   (public only)
  INGRESS_REPLICAS=<n>                           (forces Deployment)
  INGRESS_METRICS_SERVICEMONITOR=true|false
  PROXY_REAL_IP_CIDR=<csv>                       (optional override)
  PUBLIC_LB_PUBLISH_STATUS_ADDRESS=<ip|fqdn>     (pin Ingress status)
  STAR_MAIN_DOMAIN / STAR_CERT_*                 (default TLS secret)

DaemonSet + externalTrafficPolicy: Local is the default: one controller per
node, so the LB can reach a local pod on every backend and the client IP is
preserved without relying on a specific cloud annotation.

contabo/metal use NodePort for now (MetalLB support comes separately).
*/ -}}
{{- $lb := env "LB_PROVIDER" | default "" }}
{{- $class := env "INGRESS_CLASS" | default "nginx" }}
{{- $kind := env "INGRESS_CONTROLLER_KIND" | default "DaemonSet" }}
{{- $replicas := env "INGRESS_REPLICAS" | default "1" }}
{{- $sm := eq (env "INGRESS_METRICS_SERVICEMONITOR" | default "false") "true" }}

{{- /* ---------------------------------------------------------------------
   CDN / proxy ranges trusted by ngx_http_realip_module.
   Keep in sync with:
     Cloudflare -> https://www.cloudflare.com/ips-v4 and /ips-v6
     CloudFront -> https://ip-ranges.amazonaws.com/ip-ranges.json
                   (service = CLOUDFRONT_ORIGIN_FACING)
   The default proxy-real-ip-cidr is the concatenation of the four lists.
   PROXY_REAL_IP_CIDR replaces the concatenation entirely.
---------------------------------------------------------------------- */ -}}
{{- $cloudflareIPv4 := list
  "173.245.48.0/20" "103.21.244.0/22" "103.22.200.0/22" "103.31.4.0/22"
  "141.101.64.0/18" "108.162.192.0/18" "190.93.240.0/20" "188.114.96.0/20"
  "197.234.240.0/22" "198.41.128.0/17" "162.158.0.0/15" "104.16.0.0/13"
  "104.24.0.0/14" "172.64.0.0/13" "131.0.72.0/22" }}
{{- $cloudflareIPv6 := list
  "2400:cb00::/32" "2606:4700::/32" "2803:f800::/32" "2405:b500::/32"
  "2405:8100::/32" "2a06:98c0::/29" "2c0f:f248::/32" }}
{{- $cloudfrontIPv4 := list
  "3.29.57.0/26" "3.172.0.0/18" "3.172.64.0/18" "13.124.199.0/24"
  "15.158.0.0/16" "18.68.0.0/16" "24.110.128.0/17" "51.74.20.0/24"
  "51.74.21.0/24" "51.74.22.0/24" "52.46.0.0/18" "52.82.128.0/23"
  "52.82.134.0/23" "54.182.128.0/20" "54.182.144.0/21" "54.182.154.0/23"
  "54.182.156.0/22" "54.182.160.0/21" "54.182.172.0/22" "54.182.176.0/21"
  "54.182.184.0/22" "54.182.188.0/23" "54.182.224.0/21" "54.182.240.0/21"
  "54.182.248.0/22" "54.239.134.0/23" "54.239.170.0/23" "54.239.204.0/22"
  "54.239.208.0/21" "64.252.64.0/18" "64.252.128.0/18" "70.132.0.0/18"
  "130.176.0.0/18" "130.176.64.0/21" "130.176.72.0/22" "130.176.76.0/24"
  "130.176.78.0/23" "130.176.80.0/22" "130.176.86.0/23" "130.176.88.0/21"
  "130.176.96.0/19" "130.176.128.0/21" "130.176.136.0/23" "130.176.140.0/22"
  "130.176.144.0/20" "130.176.160.0/19" "130.176.192.0/19" "204.246.166.0/24"
  "205.251.218.0/24" }}
{{- $cloudfrontIPv6 := list
  "2001:3fc6:4::/48" "2001:3fc6:5::/48" "2001:3fc6:3c::/47" "2406:da10:847f:a100::/56"
  "2406:da11:438:2300::/56" "2406:da12:4b:c200::/56" "2406:da12:8b2e:9c00::/56"
  "2406:da14:17bd:2f00::/56" "2406:da14:80bb:ea00::/56" "2406:da16:c01:c200::/56"
  "2406:da18:9fa:1b00::/56" "2406:da19:e19:4a00::/56" "2406:da1a:6df:6c00::/56"
  "2406:da1b:e7c:ad00::/56" "2406:da1c:787:2b00::/56" "2406:da1c:8d8c:4600::/56"
  "2406:da1e:705:1600::/56" "2406:da1f:396:9100::/56" "2600:1f11:e79:a800::/56"
  "2600:1f13:417:4d00::/56" "2600:1f16:1923:3000::/56" "2600:1f17:4356:f100::/56"
  "2600:1f18:7530:7200::/56" "2600:1f1a:4568:b500::/56" "2600:1f1c:da:600::/56"
  "2600:1f1e:a7:2300::/56" "2600:9000:1000::/36" "2600:9000:5200::/40"
  "2600:9000:6000::/36" "2a05:d011:531:1800::/56" "2a05:d012:581:b400::/56"
  "2a05:d014:1362:b000::/56" "2a05:d016:9ed:de00::/56" "2a05:d018:1a3a:2d00::/56"
  "2a05:d019:80b:e300::/56" "2a05:d01a:8a9:be00::/56" "2a05:d01c:343:c300::/56"
  "2a05:d025:e59:fb00::/56" }}
{{- $realIP := env "PROXY_REAL_IP_CIDR" | default (join "," (concat $cloudflareIPv4 $cloudflareIPv6 $cloudfrontIPv4 $cloudfrontIPv6)) }}

{{- /* ---------------------------------------------------------------------
   Provider-specific Service. With LB_PROVIDER unset we deploy the Service as
   the cloud default (type LoadBalancer) and add NO provider annotations.
---------------------------------------------------------------------- */ -}}
{{- $serviceType := "LoadBalancer" }}
{{- $annotations := dict }}
{{- $proxyProtocol := false }}
{{- if eq $lb "" }}
{{- /* no provider: deploy as-is, no annotations */ -}}
{{- else if eq $lb "aws" }}
{{- $_ := set $annotations "service.beta.kubernetes.io/aws-load-balancer-type" "nlb" }}
{{- $_ := set $annotations "service.beta.kubernetes.io/aws-load-balancer-scheme" "internet-facing" }}
{{- $_ := set $annotations "service.beta.kubernetes.io/aws-load-balancer-cross-zone-load-balancing-enabled" "true" }}
{{- if env "AWS_LB_TAGS" }}
{{- $_ := set $annotations "service.beta.kubernetes.io/aws-load-balancer-additional-resource-tags" (env "AWS_LB_TAGS") }}
{{- end }}
{{- else if eq $lb "oci" }}
{{- $_ := set $annotations "oci.oraclecloud.com/load-balancer-type" "nlb" }}
{{- $_ := set $annotations "oci-network-load-balancer.oraclecloud.com/is-preserve-source" "true" }}
{{- if env "PUBLIC_LB_SUBNET_OCID" }}
{{- $_ := set $annotations "oci-network-load-balancer.oraclecloud.com/subnet" (env "PUBLIC_LB_SUBNET_OCID") }}
{{- end }}
{{- if env "PUBLIC_LB_NSG_OCIDS" }}
{{- $_ := set $annotations "oci-network-load-balancer.oraclecloud.com/nsg-ids" (env "PUBLIC_LB_NSG_OCIDS") }}
{{- end }}
{{- if env "PUBLIC_LB_RESERVED_IP" }}
{{- $_ := set $annotations "oci.oraclecloud.com/reserved-ips" (env "PUBLIC_LB_RESERVED_IP") }}
{{- end }}
{{- else if eq $lb "hetzner" }}
{{- $proxyProtocol = true }}
{{- $_ := set $annotations "load-balancer.hetzner.cloud/type" (env "HETZNER_LB_TYPE" | default "lb11") }}
{{- $_ := set $annotations "load-balancer.hetzner.cloud/uses-proxyprotocol" "true" }}
{{- if env "HETZNER_LB_NAME" }}
{{- $_ := set $annotations "load-balancer.hetzner.cloud/name" (env "HETZNER_LB_NAME") }}
{{- end }}
{{- if env "HETZNER_LB_LOCATION" }}
{{- $_ := set $annotations "load-balancer.hetzner.cloud/location" (env "HETZNER_LB_LOCATION") }}
{{- end }}
{{- else if eq $lb "digitalocean" }}
{{- $proxyProtocol = true }}
{{- $_ := set $annotations "service.beta.kubernetes.io/do-loadbalancer-size-slug" (env "DO_LB_SIZE" | default "lb-small") }}
{{- $_ := set $annotations "service.beta.kubernetes.io/do-loadbalancer-enable-proxy-protocol" "true" }}
{{- if env "DO_LB_NAME" }}
{{- $_ := set $annotations "service.beta.kubernetes.io/do-loadbalancer-name" (env "DO_LB_NAME") }}
{{- end }}
{{- else if or (eq $lb "contabo") (eq $lb "metal") }}
{{- $serviceType = "NodePort" }}
{{- else }}
{{ fail (printf "unknown LB_PROVIDER=%q (expected aws|oci|hetzner|digitalocean|contabo|metal)" $lb) }}
{{- end }}

{{- /* extraArgs: pinned Ingress status + optional default TLS secret */ -}}
{{- $extraArgs := dict }}
{{- if env "PUBLIC_LB_PUBLISH_STATUS_ADDRESS" }}
{{- $_ := set $extraArgs "publish-status-address" (env "PUBLIC_LB_PUBLISH_STATUS_ADDRESS") }}
{{- end }}
{{- if and (eq (env "INSTALL_STAR_CERT" | default "false") "true") (env "STAR_MAIN_DOMAIN") }}
{{- $_ := set $extraArgs "default-ssl-certificate" (printf "ingress-nginx/star-%s-tls" (replace "." "-" (env "STAR_MAIN_DOMAIN"))) }}
{{- end }}

controller:
  kind: {{ $kind }}
  replicaCount: {{ $replicas }}
  watchIngressWithoutClass: false
  ingressClass: {{ $class }}
  ingressClassResource:
    name: {{ $class }}
    enabled: true
    default: true
    controllerValue: k8s.io/ingress-nginx
  config:
    allow-snippet-annotations: "true"
    client-header-buffer-size: 100k
    large-client-header-buffers: 4 100k
    use-gzip: "true"
    compute-full-forwarded-for: "true"
    generate-request-id: "true"
    log-format-escape-json: "true"
    enable-real-ip: "true"
    proxy-real-ip-cidr: {{ $realIP | quote }}
{{- if $proxyProtocol }}
    use-proxy-protocol: "true"
{{- end }}
  service:
    type: {{ $serviceType }}
    externalTrafficPolicy: {{ if eq $kind "DaemonSet" }}Local{{ else }}Cluster{{ end }}
{{- if gt (len $annotations) 0 }}
    annotations:
{{ toYaml $annotations | nindent 6 }}
{{- end }}
  metrics:
    enabled: {{ $sm }}
    serviceMonitor:
      enabled: {{ $sm }}
{{- if gt (len $extraArgs) 0 }}
  extraArgs:
{{ toYaml $extraArgs | nindent 4 }}
{{- end }}
{{- if env "PUBLIC_LB_PUBLISH_STATUS_ADDRESS" }}
  publishService:
    enabled: false
{{- end }}
  admissionWebhooks:
    failurePolicy: {{ env "INGRESS_WEBHOOK_FAILURE_POLICY" | default "Fail" }}

defaultBackend:
  enabled: false
