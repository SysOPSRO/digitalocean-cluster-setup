ingress:
  enabled: true
  annotations:
    kubernetes.io/tls-acme: "true"
{{- if env "EXISTING_WILDCARD_CERT_SECRET" }}
    # using existing wildcard cert; no cert-manager issuer
{{- else }}
    cert-manager.io/cluster-issuer: {{ env "CERT_PROVIDER" }}-prod
{{- end }}
    kubernetes.io/ingress.class: {{ default "nginx" (env "INGRESS_CLASS") }}
  hosts:
    - host: dex.{{ requiredEnv "CLUSTER_FQDN" }}
      paths:
        - path: /
          pathType: ImplementationSpecific
  tls:
    - secretName: {{ if env "EXISTING_WILDCARD_CERT_SECRET" }}{{ env "EXISTING_WILDCARD_CERT_SECRET" }}{{ else }}dex-tls{{ end }}
      hosts:
        - dex.{{ requiredEnv "CLUSTER_FQDN" }}

config:
  issuer: https://dex.{{ requiredEnv "CLUSTER_FQDN" }}
  storage:
    type: kubernetes
    config:
      inCluster: true

  oauth2:
    responseTypes: ["code", "token", "id_token"]
    skipApprovalScreen: true

  connectors:
    - type: oidc
      id: google
      name: Google
      config:
        issuer: https://accounts.google.com
        clientID: {{ requiredEnv "GOOG_CLIENT_ID" }}
        clientSecret: {{ requiredEnv "GOOG_CLIENT_SECRET" }}
        redirectURI: https://dex.{{ requiredEnv "CLUSTER_FQDN" }}/callback
        hostedDomains:
        {{- range (requiredEnv "GOOG_ALLOWED_DOMAIN" | splitList " ") }}
         - {{ . | quote }}
        {{ end }}

  staticClients:
    - id: dex-k8s-auth
      secret: {{ requiredEnv "DEX_SECRET" }}
      name: {{ requiredEnv "DEX_NAME" }}
      redirectURIs:
        - https://login.{{ requiredEnv "CLUSTER_FQDN" }}/callback
